<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The camera drives the QR scanner (web-login / pair invites). Optional so the
         app installs on camera-less devices; the Scan screen degrades to code entry. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The invite keep-alive (ADR-0007): a dataSync foreground service holds the process
         while a minted invite waits on the relay for the new device (the user is in the
         relying-party app creating its key). POST_NOTIFICATIONS is for its "Waiting for the
         new device to join…" notification; the service runs even when it is not granted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (Android 11+) for the REVERSE same-device handoff
         (ADR-0006): after "Add a device" mints an invite, the Connect screen offers
         "Send to <app> on this phone" for each relying-party app that registers a
         pair-callback scheme and is actually installed. These entries let
         resolveActivity() see them; the registry lives in handoff/RpPairHandoff.kt.
         The <data> MUST match the RP's filter: each RP registers `scheme://pair`
         (scheme + host), and a scheme-only query does not grant visibility to a
         host-bearing filter (that gap hid the button in 0.5.1/0.5.2). Kept in step
         by handoff/RpPairManifestQueriesTest. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="heyarr-mobile" android:host="pair" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="allthing" android:host="pair" />
        </intent>
    </queries>

    <application
        android:name=".CruciformApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cruciform">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Cruciform"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Same-device app-to-app handoff: a relying-party app on THIS phone opens
                 the authenticator with the same `voidbind:login?rp=&id=` tuple its QR
                 would carry (optionally `&callback=<app-scheme-uri>`), or a
                 `voidbind:pair?…` invite. The activity is singleTask so a warm app gets
                 the link via onNewIntent and finish() returns straight to the caller.
                 See docs/adr/0003-app-to-app-deeplink-handoff.md. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voidbind" />
            </intent-filter>
            <!-- `cruciform://pair-joined?session=&dev=&sas=` — the SAME-PHONE one-tap
                 channel (ADR-0008). A relying-party app we handed an invite to reports,
                 over this LOCAL intent, the device key and SAS it derived, so the two
                 apps can settle the SAS comparison the human would otherwise make by
                 eye across two screens. It is checked against what the relay revealed
                 (handoff/SamePhonePairCallback) and never adopted; a disagreement fails
                 the pairing loudly and signs nothing. Cross-device pairing has no such
                 channel and keeps the human comparison. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cruciform" android:host="pair-joined" />
            </intent-filter>
        </activity>

        <!-- Holds the process while an invite waits for the new device (ADR-0007). -->
        <service
            android:name=".pairing.PairInviteService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Self-hosted ntfy / UnifiedPush wake receiver — Voidbind's ONLY background
             push path (no FCM/Google). A UnifiedPush distributor broadcasts these
             actions; the receiver routes an OPAQUE login tuple into the app. exported
             because the distributor is a separate app. -->
        <receiver
            android:name=".platform.push.UnifiedPushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
