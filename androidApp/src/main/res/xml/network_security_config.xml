<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext stays OFF by default (the intended public names, relay.thesim.family
     and notify.thesim.family, are HTTPS). The one exception is the Bartley Ridge LAN
     host that runs the heyarr node (:7777), All Thing (:8080), the ntfy push server
     (:2586) and the voidbind-notify push/wake plane (:2587): it serves
     `POST /membership/{usr}` over plain HTTP on the LAN — the membership push (a
     remove / a new member's add) is best-effort and carries only signed, public ops —
     and the heyarr node's `/pair` mount on :7777 is the DEFAULT pairing relay
     (RelayConfig.DEFAULT_RELAY) until the public one is deployed, and its :2587 plane
     is the DEFAULT push plane (NotifyConfig.DEFAULT_NOTIFY) on the same terms. The
     relay only carries the encrypted pairing transcript and the plane only the opaque
     login tuple, so cleartext to that host leaks nothing. A relay or plane typed into
     Settings on any OTHER host must be https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.16.224</domain>
    </domain-config>
</network-security-config>
