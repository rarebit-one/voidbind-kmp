<?xml version="1.0" encoding="utf-8"?>
<!-- RELEASE: cleartext is OFF, with no exceptions. Every endpoint a release build
     dials by default (the pairing relay, the push/wake plane, the membership-push
     RPs) is a build-time value that must be https:// (androidApp/build.gradle.kts
     refuses an http:// release default), and a relay or plane typed into Settings
     must be https too. No private LAN host is named here: a release must not carry
     one baked in.

     A DEBUG build replaces this file (src/debug/res/xml/network_security_config.xml)
     with one that permits cleartext, so device testing against a plain-http LAN node
     keeps working (docs/DEVICE-TESTING.md). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
